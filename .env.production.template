# HashLHDN MyInvois Gateway - Production Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection string
# For Docker Compose: postgresql://hashlhdn:YOUR_PASSWORD@postgres:5432/hashlhdn
# For AWS RDS: postgresql://hashlhdn:YOUR_PASSWORD@your-rds-endpoint:5432/hashlhdn
DATABASE_URL=postgresql://hashlhdn:CHANGE_THIS_PASSWORD@postgres:5432/hashlhdn

# PostgreSQL credentials (for docker-compose only)
POSTGRES_USER=hashlhdn
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
POSTGRES_DB=hashlhdn

# =============================================================================
# REDIS
# =============================================================================
# Redis connection string
# For Docker Compose: redis://redis:6379
# For AWS ElastiCache: redis://your-elasticache-endpoint:6379
REDIS_URL=redis://redis:6379

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate secure secrets with: openssl rand -hex 32
JWT_SECRET=GENERATE_A_SECURE_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=GENERATE_ANOTHER_SECURE_64_CHAR_HEX_STRING
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# =============================================================================
# MYINVOIS API (Optional fallback - companies use their own credentials)
# =============================================================================
MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET_1=
MYINVOIS_ENV=PROD

# =============================================================================
# DOCUMENT SIGNING (v1.1)
# =============================================================================
# Enable digital signing for v1.1 documents
SIGNING_ENABLED=true
SIGNING_DEFAULT_VERSION=1.1

# P12 Certificate path (inside container: /app/certs/signing.p12)
SIGNING_PKCS12_PATH=/app/certs/signing.p12

# P12 Certificate passphrase (provided by LHDN)
SIGNING_PKCS12_PASSPHRASE=YOUR_P12_PASSPHRASE

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# =============================================================================
# CORS (Optional - comma separated origins)
# =============================================================================
# CORS_ORIGINS=https://your-dashboard.com,https://api.your-domain.com
