files:
  /etc/nginx/conf.d/proxy_timeout.conf:
    mode: "000644"
    owner: root
    group: root
    content: |
      # Increase proxy timeout for MyInvois API calls (can take 60-90 seconds)
      proxy_connect_timeout 120s;
      proxy_send_timeout 120s;
      proxy_read_timeout 120s;
      send_timeout 120s;

container_commands:
  01_reload_nginx:
    command: "systemctl reload nginx || service nginx reload || true"
