container_commands:
  01_migrate:
    command: |
      echo "======= PRISMA MIGRATION START ======="
      echo "DATABASE_URL is set: ${DATABASE_URL:+yes}"
      cd /var/app/staging
      echo "Node version:"
      node --version
      echo "Checking Prisma installation..."
      ls -la node_modules/prisma/build/ 2>&1 | head -5
      echo "Running Prisma migrations..."
      node node_modules/prisma/build/index.js migrate deploy --schema=./prisma/schema.prisma 2>&1
      MIGRATE_EXIT=$?
      echo "Migration exit code: $MIGRATE_EXIT"
      if [ $MIGRATE_EXIT -ne 0 ]; then
        echo "MIGRATION FAILED!"
        exit $MIGRATE_EXIT
      fi
      echo "======= PRISMA MIGRATION END ======="
    leader_only: true
  # Seeding disabled for production - only run manually for initial setup
  # 02_seed:
  #   command: "node prisma/seed.cjs"
  #   leader_only: true
  #   ignoreErrors: true
