# CloudWatch Logs Configuration
# ==============================
# Streams application logs to CloudWatch for centralized monitoring.

option_settings:
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 30

files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/hashlhdn.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/web.stdout.log
      /var/app/current/logs/*.log
