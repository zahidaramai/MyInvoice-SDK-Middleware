# MyInvois Sandbox Validation Environment
# Copy this file to .env.sandbox.local and fill in your values
# NEVER commit .env.sandbox.local to version control!

# =============================================================================
# MyInvois Sandbox (Preprod) Configuration
# =============================================================================
MYINVOIS_ENV=sandbox

# Identity and API base URLs (preprod/sandbox)
MYINVOIS_ID_SRV_BASE=https://preprod-identity.myinvois.hasil.gov.my
MYINVOIS_API_BASE=https://preprod-api.myinvois.hasil.gov.my

# =============================================================================
# OAuth2 Credentials (obtain from LHDN portal)
# =============================================================================
# Your primary MyInvois client ID
MYINVOIS_CLIENT_ID=<<<PUT_YOUR_CLIENT_ID>>>

# Primary client secret
MYINVOIS_CLIENT_SECRET_1=<<<PUT_SECRET_1>>>

# Secondary client secret (for rotation/backup)
MYINVOIS_CLIENT_SECRET_2=<<<PUT_SECRET_2>>>

# OAuth scope (default: InvoicingAPI)
MYINVOIS_SCOPE=InvoicingAPI

# =============================================================================
# Optional: Intermediary Mode Testing
# =============================================================================
# Uncomment and set to test intermediary login (TIN or TIN:ROB format)
# MYINVOIS_ONBEHALFOF=<<<TIN or TIN:ROB>>>

# =============================================================================
# Optional: TIN Validation Testing
# =============================================================================
# Uncomment and set all 4 to test Validate TIN API (runs only once per smoke test)
# WARNING: Do not spam this API - it may be rate-limited/flagged
# TIN_VALIDATE_BUYER_TIN=<<<TIN>>>
# TIN_VALIDATE_ID_TYPE=BRN
# TIN_VALIDATE_ID_VALUE=<<<SENSITIVE_VALUE>>>
# TIN_VALIDATE_HASH_SALT=<<<LOCAL_SALT_FOR_LOGGING>>>
