# MyInvois Middleware Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Node environment
NODE_ENV=development

# Server
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://myinvois:myinvois_dev@localhost:5432/myinvois

# Redis
REDIS_URL=redis://localhost:6379

# MyInvois API (obtain from LHDN portal)
# MYINVOIS_CLIENT_ID=
# MYINVOIS_CLIENT_SECRET=
# MYINVOIS_BASE_URL=https://preprod-api.myinvois.hasil.gov.my

# Logging
LOG_LEVEL=debug
