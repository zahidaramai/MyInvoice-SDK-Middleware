# MyInvois Middleware Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Node environment
# =============================================================================
NODE_ENV=development

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0

# =============================================================================
# Database (PostgreSQL for production, SQLite for development)
# =============================================================================
DATABASE_URL=postgresql://myinvois:myinvois_dev@localhost:5432/myinvois

# =============================================================================
# Redis (for BullMQ worker)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# MyInvois API Credentials (obtain from LHDN portal)
# https://sdk.myinvois.hasil.gov.my/
# =============================================================================

# Your primary MyInvois client ID
MYINVOIS_CLIENT_ID=your-client-id-here

# Primary client secret
MYINVOIS_CLIENT_SECRET_1=your-primary-client-secret-here

# Secondary client secret (for rotation/backup)
MYINVOIS_CLIENT_SECRET_2=your-secondary-client-secret-here

# MyInvois environment: SANDBOX or PROD
MYINVOIS_ENV=SANDBOX

# =============================================================================
# Taxpayer Information (required for document submission)
# =============================================================================

# Your Tax Identification Number (TIN) - must match authenticated client
# Format: C + 12 digits (company) or IG + digits (individual)
# Example: C12345678901 or IG22570640070
MYINVOIS_SUPPLIER_TIN=your-supplier-tin-here

# ID Type: NRIC (individual), BRN (company), PASSPORT, or ARMY
MYINVOIS_SUPPLIER_ID_TYPE=BRN

# ID Value: Your NRIC number (individual) or Business Registration Number (company)
# Example: 901120125931 (NRIC) or 202001234567 (BRN)
MYINVOIS_SUPPLIER_ID_VALUE=your-id-value-here

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug

# =============================================================================
# Metrics & Observability
# =============================================================================
METRICS_ENABLED=true
METRICS_ROUTE=/metrics

# =============================================================================
# TIN Validation Cache
# =============================================================================
# Salt for hashing idValue (generate with: openssl rand -hex 32)
TIN_HASH_SALT=your-random-salt-here

# =============================================================================
# Digital Signing (v1.1 Document Support)
# =============================================================================
# Master switch to enable/disable document signing
SIGNING_ENABLED=false

# Default document version: 1.0 (unsigned) or 1.1 (signed)
SIGNING_DEFAULT_VERSION=1.0

# Certificate configuration (choose ONE method)
# Option A: File path to PEM certificate
SIGNING_CERT_PATH=/path/to/certificate.pem
# Option B: Base64-encoded certificate
# SIGNING_CERT_BASE64=LS0tLS1CRUdJTi...

# Private key configuration (choose ONE method)
# Option A: File path to PEM private key
SIGNING_KEY_PATH=/path/to/private-key.pem
# Option B: Base64-encoded private key
# SIGNING_KEY_BASE64=LS0tLS1CRUdJTi...

# Passphrase for encrypted private keys (optional)
SIGNING_KEY_PASSPHRASE=

# Certificate rotation (optional - for zero-downtime key updates)
# SIGNING_CERT_PATH_2=/path/to/certificate2.pem
# SIGNING_KEY_PATH_2=/path/to/private-key2.pem
