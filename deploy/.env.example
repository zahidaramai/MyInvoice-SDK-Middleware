# =============================================================================
# KLCubeLHDN MyInvois Gateway - AWS Elastic Beanstalk Environment Variables
# =============================================================================
# Copy this file and configure for your environment.
# Do NOT commit files with actual credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Git SHA for version tracking (set by CI/CD)
# GIT_SHA=abc123

# -----------------------------------------------------------------------------
# Database (AWS RDS PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://klcubelhdn:password@your-rds.xxxxx.ap-southeast-1.rds.amazonaws.com:5432/klcubelhdn?schema=public
DATABASE_URL=postgresql://klcubelhdn:CHANGE_ME@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/klcubelhdn?schema=public

# -----------------------------------------------------------------------------
# Redis (AWS ElastiCache)
# -----------------------------------------------------------------------------
# Format: redis://HOST:PORT
# Example: redis://your-elasticache.xxxxx.apne1.cache.amazonaws.com:6379
REDIS_URL=redis://your-elasticache-endpoint.ap-southeast-1.cache.amazonaws.com:6379

# -----------------------------------------------------------------------------
# JWT Authentication (REQUIRED)
# -----------------------------------------------------------------------------
# Generate secrets with: openssl rand -hex 32
# IMPORTANT: Use different secrets for access and refresh tokens
JWT_SECRET=GENERATE_64_HEX_CHARS_HERE
JWT_REFRESH_SECRET=GENERATE_64_HEX_CHARS_HERE

# Token expiry times
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Session TTL in milliseconds (default: 24 hours)
SESSION_TTL_MS=86400000

# Token renew skew in milliseconds (default: 30 seconds)
TOKEN_RENEW_SKEW_MS=30000

# Validate MyInvois credentials on session creation
VALIDATE_UPSTREAM=false

# -----------------------------------------------------------------------------
# TIN Validation Cache
# -----------------------------------------------------------------------------
# Salt for hashing TIN values (REQUIRED in production)
# Generate with: openssl rand -hex 16
CACHE_HASH_SALT=GENERATE_32_HEX_CHARS_HERE

# Cache TTL for valid TIN entries (days)
TIN_VALIDATE_CACHE_TTL_DAYS_VALID=180

# Cache TTL for invalid TIN entries (days)
TIN_VALIDATE_CACHE_TTL_DAYS_INVALID=7

# -----------------------------------------------------------------------------
# Document Signing (v1.1) - PKCS#12 Certificate from LHDN
# -----------------------------------------------------------------------------
# Enable document signing (required for v1.1 submissions)
SIGNING_ENABLED=true

# Default document version (1.0 or 1.1)
SIGNING_DEFAULT_VERSION=1.1

# Option 1: PKCS#12 file path (recommended)
# The P12 file can be downloaded from S3 via .ebextensions
SIGNING_PKCS12_PATH=/var/app/staging/certs/signing.p12
SIGNING_PKCS12_PASSPHRASE=your-p12-passphrase

# Option 2: PKCS#12 base64 encoded (alternative)
# SIGNING_PKCS12_BASE64=MIIKEQIBAzCC...
# SIGNING_PKCS12_PASSPHRASE=your-p12-passphrase

# Option 3: Separate certificate and key files (alternative)
# SIGNING_CERT_PATH=/path/to/certificate.pem
# SIGNING_KEY_PATH=/path/to/private-key.pem
# SIGNING_KEY_PASSPHRASE=your-key-passphrase

# -----------------------------------------------------------------------------
# Observability & Metrics
# -----------------------------------------------------------------------------
# Enable Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_ROUTE=/metrics

# -----------------------------------------------------------------------------
# MyInvois API Environment (Per-Company Configuration)
# -----------------------------------------------------------------------------
# Note: MyInvois credentials are stored per-company in the database.
# These are NOT set as environment variables.
# Configure via the /api/v1/companies/:id/credentials endpoint.

# =============================================================================
# AWS-SPECIFIC NOTES
# =============================================================================
#
# Setting Environment Variables in Elastic Beanstalk:
# --------------------------------------------------
# 1. AWS Console: Environment > Configuration > Software > Environment properties
# 2. EB CLI: eb setenv KEY=value
# 3. .ebextensions: option_settings in config files
#
# Secrets Management:
# ------------------
# For production, consider using AWS Secrets Manager or Parameter Store
# instead of plain environment variables for sensitive values like:
# - DATABASE_URL (contains password)
# - JWT_SECRET / JWT_REFRESH_SECRET
# - SIGNING_PKCS12_PASSPHRASE
#
# P12 Certificate Handling:
# ------------------------
# 1. Upload certificate to S3 bucket
# 2. Configure .ebextensions/03-certificate.config to download on deploy
# 3. Ensure EC2 instance role has s3:GetObject permission
#
# =============================================================================
